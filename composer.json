{
    "name": "beste/firebase-jwt",
    "description": "A library to work with Firebase tokens",
    "license": "BSD-3-Clause",
    "type": "library",
    "authors": [
        {
            "name": "Jérôme Gamez",
            "email": "jerome@gamez.name"
        }
    ],
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "beste/in-memory-cache": "^1.2",
        "lcobucci/jwt": "^5.2",
        "php-http/discovery": "^1.19.2",
        "php-standard-library/php-standard-library": "^5.5 || ^6.2.1",
        "psr/cache": "^2.0 || ^3.0",
        "psr/http-client": "^1.0.3",
        "psr/http-client-implementation": "^1.0",
        "psr/http-factory": "^1.0.2",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "beste/clock": "^3.0",
        "google/auth": "^1.33",
        "nyholm/psr7": "^1.8.1",
        "symfony/http-client": "^6.4.2 || ^7.0.2  || ^8.1.0",
        "symfony/var-dumper": "^6.4.2 || ^7.0.2 || ^8.1.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "suggest": {
        "psr/cache-implementation": "Allows caching of certificates fetched from Google to verify tokens",
        "psr/clock-implementation": "Allows using an existing clock, for example a frozen clock for tests"
    },
    "autoload": {
        "psr-4": {
            "Beste\\Firebase\\JWT\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Beste\\Firebase\\JWT\\Tests\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "scripts": {
        "analyze": "XDEBUG_MODE=none tools/phpstan --ansi analyse",
        "clean": [
            "@clean:build-artifacts",
            "@clean:vendor"
        ],
        "clean:build-artifacts": [
            "rm -rf build && mkdir -p build"
        ],
        "clean:vendor": "rm -rf vendor",
        "dependencies:check": [
            "@clean",
            "@tools:install",
            "@dependencies:install",
            "XDEBUG_MODE=none composer outdated --locked --direct --strict --sort-by-age --ansi"
        ],
        "dependencies:install": "composer install --no-interaction --no-progress --ansi",
        "dependencies:update": [
            "XDEBUG_MODE=none composer update --no-interaction --no-progress --ansi",
            "XDEBUG_MODE=none composer bump --no-interaction --ansi"
        ],
        "lint": [
            "XDEBUG_MODE=none tools/.rector/vendor/bin/rector --ansi --dry-run",
            "XDEBUG_MODE=none tools/php-cs-fixer check --ansi --diff --verbose",
            "@lint:composer"
        ],
        "lint:composer": "XDEBUG_MODE=none tools/composer-normalize --ansi --dry-run",
        "lint:composer:fix": "XDEBUG_MODE=none tools/composer-normalize --ansi",
        "lint:fix": [
            "XDEBUG_MODE=none tools/.rector/vendor/bin/rector --ansi",
            "XDEBUG_MODE=none tools/php-cs-fixer fix --ansi --diff --verbose",
            "@lint:composer:fix"
        ],
        "setup": [
            "@clean:build-artifacts",
            "@tools:install",
            "@dependencies:install",
            "@tools:phpstan:install",
            "@tools:phpstan:update",
            "@tools:rector:install",
            "@tools:rector:update",
            "@tools:link"
        ],
        "test": "@test:all",
        "test:all": [
            "@analyze",
            "@lint",
            "@test:bc",
            "@test:unit"
        ],
        "test:bc": "docker run --rm -v \"$PWD\":/app nyholm/roave-bc-check",
        "test:coverage": "XDEBUG_MODE=coverage tools/phpunit --colors=always --testdox --coverage-text --coverage-html=build/coverage --coverage-clover=build/coverage/clover.xml",
        "test:unit": "XDEBUG_MODE=develop tools/phpunit --colors=always --testdox",
        "tools:install": "tools/phive --no-progress install --trust-gpg-keys E82B2FB314E9906E,4AA394086372C20A,C00543248C87FB13,033E5F8D801A2F8D",
        "tools:link": [
            "ln -snf phpunit tools/phpunit.phar",
            "ln -snf .phpstan/vendor/bin/phpstan tools/phpstan",
            "ln -snf .rector/vendor/bin/rector tools/rector"
        ],
        "tools:phpstan:install": "XDEBUG_MODE=none composer --working-dir=tools/.phpstan install --no-interaction --no-progress --ansi",
        "tools:phpstan:update": [
            "XDEBUG_MODE=none composer --working-dir=tools/.phpstan update --no-interaction --no-progress --ansi",
            "XDEBUG_MODE=none composer --working-dir=tools/.phpstan bump --no-interaction --ansi"
        ],
        "tools:rector:install": "XDEBUG_MODE=none composer --working-dir=tools/.rector install --no-interaction --no-progress --ansi",
        "tools:rector:update": [
            "XDEBUG_MODE=none composer --working-dir=tools/.rector update --no-interaction --no-progress --ansi",
            "XDEBUG_MODE=none composer --working-dir=tools/.rector bump --no-interaction --ansi"
        ],
        "tools:update": [
            "tools/phive --no-progress self-update",
            "tools/phive --no-progress update",
            "@tools:phpstan:update",
            "@tools:rector:update",
            "@tools:link"
        ]
    }
}
